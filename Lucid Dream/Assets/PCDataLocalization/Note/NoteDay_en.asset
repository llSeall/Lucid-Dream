  m_TableData:
  - m_Id: 21240669073408
    m_Localized: "Day 1 of preparing for the injection\r\n  I honestly have no idea
      what I'm even dealing with anymore.\r\nWhy have these dreams within dreams
      gotten this bad?\r\n\r\nWho would've thought I'd actually lose my job just
      because I've been having nightmares night after night?\r\n\r\nGod... Is my
      life not miserable enough already?\r\n\r\nThe doctor told me I have about three
      days to decide whether I want to get the injection to erase these dreams.\r\n\r\nSigh...
      Why do I even have to wait?\r\nThey could just erase them now.\r\n"
    m_Metadata:
      m_Items: []
