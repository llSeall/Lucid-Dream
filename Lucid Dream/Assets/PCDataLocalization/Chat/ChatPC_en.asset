  m_TableData:
  - m_Id: 20522595840000
    m_Localized: New Message
    m_Metadata:
      m_Items: []
  - m_Id: 20832139669504
    m_Localized: "-------------\nWhen are you finally going to get the injections
      to treat your illness, sweetheart? How many times have I reminded you already
      that it\u2019s going to ruin your life? Why can\u2019t you learn to listen
      to your mother like your younger sibling does??\r\n\r\nAnd honestly, what are
      you going to do to keep up with them if you keep going like this???\r\n\r\n...Can
      you please just stop disappointing me for once?\r\n-------------"
    m_Metadata:
      m_Items: []
  - m_Id: 21159194718208
    m_Localized: MOM
    m_Metadata:
      m_Items: []
  - m_Id: 23585888989184
    m_Localized: "-------------\nHey!! I heard you went to the hospital to get treatment
      for your dream sickness?\n\nWait, is that actually true?? I was so surprised
      I had to dig through my old chats just to find this one, lol.\n\nOh, yeah\u2014anyway,
      that's not actually the only reason I messaged you.\nI just wanted to ask how
      you've been doing lately. Do you still wanna draw? I kinda miss your art style,
      man.\n-------------"
    m_Metadata:
      m_Items: []
  - m_Id: 23651857002496
    m_Localized: Tim
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
